# Copy to relay/.env (git-ignored) and fill in. Wrangler reads it when deploying.
# Token: dash.cloudflare.com → My Profile → API Tokens → Create Token → "Edit Cloudflare Workers"
# template (covers Workers scripts and Workers KV). Account ID: right sidebar of the Workers & Pages page.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
